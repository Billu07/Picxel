# Copy to `.env` for local development. Never commit `.env`.

PICXEL_ENV=local
PICXEL_PUBLIC_URL=http://localhost:8000
PICXEL_LOG_LEVEL=INFO

# Optional in Phase 0 — the app runs without a database.
# Start one with `docker compose up db`, then uncomment.
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and stalls (decision.md D-006).
# PICXEL_DATABASE_URL=postgresql://picxel:picxel@127.0.0.1:5432/picxel

# Database tests use a separate database so they never touch your dev data.
# PICXEL_TEST_DATABASE_URL=postgresql://picxel:picxel@127.0.0.1:5432/picxel_test
